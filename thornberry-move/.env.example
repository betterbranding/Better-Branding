# Supabase project settings (Project Settings > API). Both values are safe to expose in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server only (used by /api/price for AI furniture pricing). Never prefix with VITE_.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the Gemini model
# GEMINI_MODEL=gemini-2.5-flash
